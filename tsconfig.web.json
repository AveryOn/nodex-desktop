{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue"
  ],
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      //  TODO: после перехода на ~ удалить все импорты в коде начинающиеся на @renderer
      "@renderer/*": ["src/renderer/src/*"]
    }
  }
}
