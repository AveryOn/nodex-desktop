{
  "name": "nodex",
  "version": "1.0.0",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": {
    "name": "Vladislav Everi",
    "email": "averyvladislav00@gmail.com"
  },
  "type": "module",
  "homepage": "https://electron-vite.org",
  "build": {
    "appId": "com.nodex.desktop",
    "productName": "Nodex",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "drizzle",
        "to": "drizzle"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --mode devlocal",
    "dev:local": "electron-vite dev --mode devlocal",
    "dev:development": "electron-vite dev --mode development",
    "build": "npm run typecheck && electron-vite build --mode production",
    "build:development": "npm run typecheck && electron-vite build --mode development",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild:native",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "12.10.0",
    "drizzle-orm": "0.44.2",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "4.0.3",
    "@playwright/test": "1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "6.0.7",
    "drizzle-kit": "0.31.10",
    "electron": "37.0.0",
    "electron-builder": "26.11.0",
    "electron-vite": "5.0.0",
    "eslint": "10.4.0",
    "eslint-plugin-vue": "^10.6.2",
    "pinia": "^3.0.4",
    "prettier": "^3.7.4",
    "typescript": "6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "7.1.12",
    "vitest": "4.1.7",
    "vue": "3.5.34",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "5.0.7",
    "vue-tsc": "^3.1.6"
  }
}
